@model RelatorioEstagiario.Models.RelatorioEstagio

@{
    ViewData["Title"] = "Excluir Relatório";
}

<h1>Excluir Relatório</h1>

<h3>Tem certeza que deseja excluir este relatório?</h3>

<div>
    <p>
        <strong>Nome:</strong> @Model.Nome
    </p>

    <p>
        <strong>Curso:</strong> @Model.Curso
    </p>

    <p>
        <strong>Empresa:</strong> @Model.EmpresaConcedente
    </p>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">
        Sim, excluir
    </button>

    <a asp-action="Index">
        Cancelar
    </a>

</form>