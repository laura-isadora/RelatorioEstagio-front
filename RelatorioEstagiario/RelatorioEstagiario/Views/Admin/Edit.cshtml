@model RelatorioEstagiario.Models.RelatorioEstagio

@{
    ViewData["Title"] = "Editar Relatório";
}

<h1>Editar Relatório</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Nome">Nome:</label>
        <input asp-for="Nome" />
    </div>

    <div>
        <label asp-for="Matricula">Matrícula:</label>
        <input asp-for="Matricula" />
    </div>

    <div>
        <label asp-for="Curso">Curso:</label>
        <input asp-for="Curso" />
    </div>

    <div>
        <label asp-for="EmpresaConcedente">Empresa:</label>
        <input asp-for="EmpresaConcedente" />
    </div>

    <button type="submit">
        Salvar Alterações
    </button>

    <a asp-action="Index">
        Cancelar
    </a>

</form>