@{
    ViewData["Title"] = "Relatório de Estagiário";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1>Relatório de Estagiário</h1>

        <p class="lead">
            Selecione uma opção para continuar
        </p>
    </div>

    <div class="row justify-content-center">

        <!-- Novo Relatório -->
        <div class="col-md-4 mb-3">

            <div class="card shadow h-100">
                <div class="card-body text-center">

                    <h3>Novo Relatório</h3>

                    <p>
                        Deseja preencher um novo relatório
                        de estágio?
                    </p>

                    <a asp-controller="Relatorio"
                       asp-action="Create"
                       class="btn btn-primary">
                        Fazer novo relatório
                    </a>

                </div>
            </div>

        </div>

        <!-- Administrador -->
        <div class="col-md-4 mb-3">

            <div class="card shadow h-100">
                <div class="card-body text-center">

                    <h3>Administrador</h3>

                    <p>
                        Acesse a área administrativa
                        do sistema.
                    </p>

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="btn btn-dark">
                        Área administrativa
                    </a>

                </div>
            </div>

        </div>

    </div>

</div>
