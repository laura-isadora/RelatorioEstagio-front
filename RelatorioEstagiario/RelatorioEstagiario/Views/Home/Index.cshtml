@{
    ViewData["Title"] = "Relatório de Estágio";
}

<div class="home-container">

    <div class="home-content">

        <h1>Relatório de Estágio</h1>

        <p>
            Bem-vindo ao sistema de relatório de estágio.
        </p>

        <p>
            Aqui você poderá preencher, consultar e gerenciar
            seus relatórios de estágio.
        </p>

        <div class="home-buttons">

            <a asp-controller="Relatorio"
               asp-action="Create"
               class="btn btn-primary">
                Novo Relatório
            </a>

            <a asp-controller="Relatorio"
               asp-action="Index"
               class="btn btn-secondary">
                Meus Relatórios
            </a>

        </div>

    </div>

</div>