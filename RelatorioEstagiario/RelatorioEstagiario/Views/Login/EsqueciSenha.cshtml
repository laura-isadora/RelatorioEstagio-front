@model RelatorioEstagiario.Models.Adm.EsqueciSenhaModel

@{
    ViewData["Title"] = "Recuperar senha";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-4">

            <div class="card shadow">

                <div class="card-body">

                    <h2 class="text-center mb-4">
                        Recuperar senha
                    </h2>

                    <p class="text-muted text-center">
                        Informe o e-mail cadastrado para receber
                        o link de redefinição da senha.
                    </p>

                    <form asp-controller="Login"
                          asp-action="EsqueciSenha"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                E-mail
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Enviar link
                        </button>

                    </form>

                    @if (TempData["Mensagem"] != null)
                    {
                        <div class="alert alert-success mt-3">
                            @TempData["Mensagem"]
                        </div>
                    }

                    <div class="text-center mt-3">

                        <a asp-controller="Login"
                           asp-action="Index">
                            Voltar para o login
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
